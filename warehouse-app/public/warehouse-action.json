{
  "openapi": "3.1.0",
  "info": {
    "title": "재고 마스터 미승인 자료 등록",
    "version": "2.3.0",
    "description": "미승인 거래를 저장합니다. 사용자 확정 주문품은 기존 SKU에 연결하거나 한 번 생성합니다. 창고 증감은 일일 마감 승인 때 반영됩니다."
  },
  "servers": [
    {
      "url": "https://warehouse-app-wine.vercel.app"
    }
  ],
  "paths": {
    "/api/preflight": {
      "post": {
        "operationId": "previewWarehouseDocument",
        "summary": "저장 전 문서와 각 행의 실제 처리 결과 확인",
        "description": "읽기 전용. can_submit, blockers와 모든 lines를 확인한다.",
        "x-openai-isConsequential": false,
        "security": [
          {
            "intakeKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Document"
                  },
                  {
                    "$ref": "#/components/schemas/OpeningConfirmation"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "읽기 전용 사전 검증 결과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요"
          },
          "403": {
            "description": "키가 만료되었거나 유효하지 않음"
          },
          "409": {
            "description": "같은 ID의 내용이 다름",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "blockers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "입력 형식 확인 필요",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "blockers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/intake": {
      "post": {
        "operationId": "submitWarehouseDocument",
        "summary": "분석한 문서 한 버전을 검토 대상으로 등록",
        "description": "사용자가 등록을 요청하고 사전 검증을 확인한 뒤, 동일 문서에 preview_stamp를 넣어 미승인 접수. verified와 stored_lines를 대조한다.",
        "x-openai-isConsequential": true,
        "security": [
          {
            "intakeKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Document"
                  },
                  {
                    "$ref": "#/components/schemas/OpeningConfirmation"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "기존 문서. 상태와 실제 저장값 확인",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "201": {
            "description": "미승인 거래 등록 및 대조 완료",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "401": {
            "description": "인증 필요"
          },
          "403": {
            "description": "키가 만료되었거나 유효하지 않음"
          },
          "409": {
            "description": "같은 ID의 내용이 다름",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "blockers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "입력 형식 확인 필요",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "blockers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "intakeKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Document": {
        "type": "object",
        "required": [
          "schema_version",
          "document_id",
          "document_type",
          "version",
          "work_date",
          "category",
          "lines",
          "case_id"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "enum": [
              2
            ],
            "description": "분석 등록 규격"
          },
          "document_id": {
            "type": "string",
            "description": "이 원본 버전의 고유 식별자. 동일 전송 시 재사용",
            "maxLength": 160
          },
          "case_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "확인된 출고 또는 생산 건 식별자. 거래처·날짜만으로 만들지 않는다."
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999
          },
          "is_revision": {
            "type": "boolean"
          },
          "replaces": {
            "type": [
              "string",
              "null"
            ],
            "description": "직전 버전의 document_id"
          },
          "document_type": {
            "type": "string",
            "description": "출고지시서, 출고의뢰서, 생산입고 메시지 등"
          },
          "work_date": {
            "type": "string",
            "format": "date",
            "description": "한국 작업일. 출고가 확정된 지시는 출고 예정일. 자료 시각은 source_time에 별도로 보존한다."
          },
          "source_time": {
            "type": [
              "string",
              "null"
            ],
            "description": "시간대가 포함된 원본 ISO 시각"
          },
          "category": {
            "type": "string",
            "enum": [
              "production_in",
              "production_out",
              "sale"
            ]
          },
          "customer": {
            "type": [
              "string",
              "null"
            ],
            "description": "원문 거래처명"
          },
          "method": {
            "type": [
              "string",
              "null"
            ],
            "description": "기본 영업출고 방식. 직납·화물·방문·퀵·퀵(용차 배송)·용차. 원문 표기 보존."
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "카카오톡 메시지 또는 원본 문서 종류"
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "분석의 근거가 된 원문"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "실제 원본 파일명"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "실제 파일 바이트로 계산할 수 있을 때만 기입"
              },
              "reply_to": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "답장 대상 원본 식별자"
              },
              "message_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "실제 원본 메시지 식별자"
              },
              "issuer": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "원문 지시자"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "최종본 등 대조한 근거"
              }
            },
            "additionalProperties": false
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": [
                "line_id",
                "raw_name",
                "qty"
              ],
              "properties": {
                "line_id": {
                  "type": "string",
                  "description": "같은 건의 수정 전후 같은 품목 행에 유지하는 ID",
                  "maxLength": 160
                },
                "raw_name": {
                  "type": "string",
                  "description": "원문 품목명",
                  "maxLength": 600
                },
                "sku": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "확실한 마스터 SKU 또는 품목 UUID"
                },
                "spec": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "원문 전체 사양과 주문 조건"
                },
                "qty": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "review_reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "판독 불확실 사유"
                },
                "item_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "확인된 활성 마스터 UUID",
                  "format": "uuid"
                },
                "standard_name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "확정된 표준 품목명"
                },
                "standard_spec": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "표준화한 사양"
                },
                "match_basis": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "사용자 확인 또는 적용한 명칭·사양 근거. 이 행에만 적용."
                },
                "context": {
                  "type": [
                    "string",
                    "null"
                  ],
